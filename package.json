{
    "name": "fetchary",
    "version": "0.5.0",
    "description": "Watch changes. Keep the proof.",
    "keywords": [
        "archive",
        "change-detection",
        "evidence",
        "monitoring",
        "osint",
        "web",
        "web-archiving"
    ],
    "homepage": "https://github.com/oliverjessner/fetchary#readme",
    "bugs": {
        "url": "https://github.com/oliverjessner/fetchary/issues"
    },
    "author": {
        "name": "oliverjessner",
        "url": "https://oliverjessner.at"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oliverjessner/fetchary.git"
    },
    "license": "MIT",
    "type": "commonjs",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "require": "./src/index.js",
            "import": "./src/index.js"
        }
    },
    "bin": {
        "fetchary": "cli/index.js"
    },
    "files": [
        "cli",
        "src",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "publish": "node ./scripts/publish.js",
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage"
    },
    "dependencies": {
        "linkedom": "^0.18.13",
        "puppeteer": "^25.12.0"
    },
    "allowScripts": {
        "puppeteer@25.12.0": true
    }
}
