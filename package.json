{
    "name": "fetchary",
    "version": "2.0.6",
    "description": "Extract what matters. Semantic web extraction for Node.js and the command line, with optional browser login.",
    "keywords": [
        "web",
        "extraction",
        "scraping",
        "cli",
        "nodejs",
        "html",
        "favicon",
        "social-media"
    ],
    "homepage": "https://github.com/oliverjessner/fetchary#readme",
    "bugs": {
        "url": "https://github.com/oliverjessner/fetchary/issues"
    },
    "author": {
        "name": "oliverjessner",
        "url": "https://oliverjessner.at"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oliverjessner/fetchary.git"
    },
    "license": "MIT",
    "type": "commonjs",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "require": "./src/index.js",
            "import": "./src/index.js"
        }
    },
    "bin": {
        "fetchary": "cli/index.js"
    },
    "files": [
        "cli",
        "src",
        "docs",
        "assets/images/logo/logo_raw_trans_250.webp",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "publish": "node ./scripts/publish.js",
        "test": "node --require ./test-support/setup.cjs --test --test-concurrency=2",
        "test:coverage": "node --require ./test-support/setup.cjs --test --test-concurrency=2 --experimental-test-coverage"
    },
    "dependencies": {
        "libphonenumber-js": "^1.13.15",
        "linkedom": "^0.18.13",
        "puppeteer": "^25.12.0"
    },
    "allowScripts": {
        "puppeteer": true
    }
}
